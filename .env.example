# PokéStatle
NEXT_PUBLIC_APP_URL=http://127.0.0.1:43127

# Daily challenge salt — never expose to the browser
SECRET_SALT=change-me-to-a-long-random-string

# Local SQLite lives at ./data/pokestatle.db (created automatically).
# Used when DATABASE_URL is unset (local guest / offline).

# Supabase Auth (Google)
# Local Supabase ports are customized in supabase/config.toml:
#   API 54331 | DB 54332 | Studio 54333 | Inbucket 54334
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Postgres — required in production so Auth stats/games/pokemon persist.
# Project Settings → Database → Connection string (URI).
# Prefer Session mode / direct for `pnpm db:push-supabase`; Transaction pooler is fine for the app.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Google OAuth is configured in the Supabase Auth dashboard (provider: Google)
# Redirect URL (prod): https://pokestatle.vercel.app/api/auth/callback
